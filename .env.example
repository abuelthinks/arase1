# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Django secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# AWS S3 — set USE_S3=False for local dev (uses local filesystem instead)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-southeast-1

# Database — leave blank to use SQLite in dev
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend URL (used in invite emails and CORS)
FRONTEND_URL=http://localhost:3000

# Redis — required for Celery and WebSocket channel layer
# REDIS_URL=redis://localhost:6379/0

# SMS backend: 'console' logs to stdout, 'smstrap' uses local dev trap, 'twilio' or 'vonage' for production
SMS_BACKEND=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_PHONE=+1xxxxxxxxxx

# Production only — comma-separated list of allowed CORS origins
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# ALLOWED_HOSTS=your-railway-app.up.railway.app
